@startuml Sistema de Gestão de eBooks
left to right direction

actor "Aluno" as aluno
actor "Bibliotecário" as bib

rectangle "Sistema de Gestão de eBooks" {
  usecase "Adicionar eBook\nà estante"        as UC_adicionar
  usecase "Registrar estatística\nde uso"     as UC_estatistica
  usecase "Remover eBook\nda estante"         as UC_remover
  usecase "Acessar eBook"                     as UC_acessar
  usecase "Realizar login"                    as UC_login
  usecase "Cadastrar eBook"                   as UC_cadastrar
  usecase "Consultar alunos\ncom eBook"       as UC_consultar
  usecase "Renovar catálogo\ndo semestre"     as UC_renovar
}

' --- Aluno ---
aluno --> UC_adicionar
aluno --> UC_remover
aluno --> UC_acessar
aluno --> UC_login

' --- Bibliotecário ---
bib --> UC_login
bib --> UC_cadastrar
bib --> UC_consultar
bib --> UC_renovar

' --- Relacionamento include ---
UC_adicionar ..> UC_estatistica : <<include>>

@enduml