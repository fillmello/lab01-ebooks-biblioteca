@startuml casos_de_uso_ebooks
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Aluno" as Aluno
actor "Bibliotecário" as Bibliotecario
actor "Sistema de Estatísticas de Uso" as Estatisticas

rectangle "Sistema de Gestão de eBooks" {
  usecase "Realizar login" as UC01
  usecase "Adicionar eBook à estante" as UC02
  usecase "Remover eBook da estante" as UC03
  usecase "Acessar eBook" as UC04
  usecase "Cadastrar eBook" as UC05
  usecase "Consultar alunos com um eBook" as UC06
  usecase "Notificar sistema de\nestatísticas de uso" as UC07
  usecase "Renovar catálogo do semestre" as UC08
}

' --- Associações do Aluno ---
Aluno --> UC01
Aluno --> UC02
Aluno --> UC03
Aluno --> UC04

' --- Associações do Bibliotecário ---
Bibliotecario --> UC01
Bibliotecario --> UC05
Bibliotecario --> UC06
Bibliotecario --> UC08

' --- Ator externo notificado pelo sistema ---
UC07 --> Estatisticas

' --- Login obrigatório: todo acesso ao sistema valida a senha do usuário ---
UC02 ..> UC01 : <<include>>
UC03 ..> UC01 : <<include>>
UC04 ..> UC01 : <<include>>
UC05 ..> UC01 : <<include>>
UC06 ..> UC01 : <<include>>

' --- Adicionar eBook sempre notifica o sistema de estatísticas de uso ---
UC02 ..> UC07 : <<include>>

@enduml
