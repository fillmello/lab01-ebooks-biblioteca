@startuml Sistema de Gestão de eBooks
left to right direction

actor "Usuário do Sistema" as usuario
actor "Aluno" as aluno
actor "Bibliotecário" as bib

' --- Aluno e Bibliotecário são especializações de Usuário do Sistema ---
aluno --|> usuario
bib --|> usuario

rectangle "Sistema de Gestão de eBooks" {
  usecase "UC01 - Realizar login"                   as UC_login
  usecase "UC02 - Adicionar eBook\nà estante"       as UC_adicionar
  usecase "UC03 - Remover eBook\nda estante"        as UC_remover
  usecase "UC04 - Acessar eBook"                    as UC_acessar
  usecase "UC05 - Cadastrar eBook"                  as UC_cadastrar
  usecase "UC06 - Consultar alunos\ncom eBook"      as UC_consultar
  usecase "UC07 - Registrar estatística\nde uso"    as UC_estatistica
  usecase "UC08 - Renovar catálogo\ndo semestre"    as UC_renovar
}

' --- Usuário do Sistema (vale para os dois perfis) ---
usuario --> UC_login

' --- Aluno ---
aluno --> UC_adicionar
aluno --> UC_remover
aluno --> UC_acessar

' --- Bibliotecário ---
bib --> UC_cadastrar
bib --> UC_consultar
bib --> UC_renovar

' --- Relacionamento include ---
UC_adicionar ..> UC_estatistica : <<include>>

@enduml